APP_ENV=dev
HTTP_ADDR=:8080
DB_PATH=./data/ecommerce_support.db
DEV_API_ENABLED=true
# openai=真实模型；offline=本地规则演示模型（仅 dev/test，无需密钥）
LLM_PROVIDER=openai
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=5
LLM_MAX_TOOL_CALLS_PER_TURN=8
# 大模型调用日志（排查用）：off | summary | detail | full
#   summary=只记调用外形/耗时/结果/token；detail=再加消息预览与工具参数；full=再加完整请求与响应
LLM_LOG_LEVEL=detail
# JSONL 追加写，一行一个事件（start/end 成对，用 call_id 关联）；填 - 表示只写进程日志
LLM_LOG_FILE=./data/llm_calls.jsonl
LLM_LOG_BODY_CHARS=4000
CONVERSATION_RECENT_TURNS=6
CONVERSATION_MAX_CONTEXT_CHARS=40000
PENDING_ACTION_TTL_MINUTES=10
LOG_LEVEL=info
# 以下为实现扩展的管理参数（规格书未强制）
TOOL_TIMEOUT_SECONDS=10
AFTER_SALES_WINDOW_DAYS=7
PRICE_PROTECTION_WINDOW_DAYS=15

# 运营后台（/admin/）。内置账号仅在 admin_users 为空时创建一次，
# 之后修改这里不会覆盖已有密码。非 dev/test 环境必须改掉默认密码，否则拒绝启动。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_SESSION_TTL_HOURS=12
